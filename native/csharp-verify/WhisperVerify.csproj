<Project Sdk="Microsoft.NET.Sdk">
  <!--
    纯 C# 验证工程：把 Unity 仓库里的**真实源文件**直接链接进来编译并断言。
    为什么不复制：复制会验证副本而不是真货；用 <Compile Include> 链接同一份文件才是真验证。
    哪些源文件能进来：不引用 UnityEngine 的那些（Core 契约 / DesignTokens / Gameplay 的 Level 层）。
    Boot/Bootstrap 依赖 UnityEngine，不在本工程内 —— 它由 Unity Test Framework（PlayMode）覆盖。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>whisper-verify</AssemblyName>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../unity/Assets/Scripts/Core/Contracts/*.cs" />
    <Compile Include="../../unity/Assets/Scripts/Core/Services.cs" />
    <Compile Include="../../unity/Assets/Scripts/Core/DesignTokens.cs" />
    <Compile Include="../../unity/Assets/Scripts/Gameplay/Level/*.cs" />
    <!-- LevelBuilder 引用 UnityEngine（MonoBehaviour/GameObject/Material…），不属于本机跑手范围；
         它由 tools/unity-syntax-check.sh（Roslyn + Unity 桩）与 Unity Test Framework 覆盖。 -->
    <Compile Remove="../../unity/Assets/Scripts/Gameplay/Level/LevelBuilder.cs" />
    <!-- LevelBuilder 是 partial：Doors/LightRig 是它的其余分部，同样引用 UnityEngine
         （Transform/Vector3/Light/GameObject/MonoBehaviour），必须一并排除 —— 否则
         "排了主文件、漏了分部"会让本工程以 CS0246 全线崩掉（实测踩过）。 -->
    <Compile Remove="../../unity/Assets/Scripts/Gameplay/Level/LevelBuilder.Doors.cs" />
    <Compile Remove="../../unity/Assets/Scripts/Gameplay/Level/LevelBuilder.LightRig.cs" />
    <!-- KitMeshLibrary 引用 UnityEngine（Mesh/Application.streamingAssetsPath）→ 同上由
         tools/unity-syntax-check.sh 覆盖；它的纯逻辑部分由 KitVerifier 断言（本工程内）。 -->
    <Compile Remove="../../unity/Assets/Scripts/Gameplay/Level/KitMeshLibrary.cs" />
    <Compile Include="../../unity/Assets/Scripts/Gameplay/Config/*.cs" />
    <Compile Include="../../unity/Assets/Scripts/Gameplay/Voice/*.cs" />
    <Compile Include="../../unity/Assets/Scripts/Gameplay/Hearing/*.cs" />
    <Compile Include="../../unity/Assets/Scripts/Gameplay/Monsters/*.cs" />
    <Compile Include="../../unity/Assets/Scripts/Gameplay/Sanity/*.cs" />
    <Compile Include="../../unity/Assets/Scripts/Gameplay/Extraction/*.cs" />
    <Compile Include="../../unity/Assets/Scripts/Gameplay/Match/*.cs" />
    <Compile Include="../../unity/Assets/Scripts/Gameplay/Items/*.cs" />
    <Compile Include="../../unity/Assets/Scripts/Gameplay/Hud/*.cs" />
    <!-- HudBuilder 引用 UnityEngine（Canvas/Text/RectTransform）→ 由 tools/unity-syntax-check.sh 覆盖 -->
    <Compile Remove="../../unity/Assets/Scripts/Gameplay/Hud/HudBuilder.cs" />
    <Compile Include="../../unity/Assets/Scripts/Gameplay/Session/*.cs" />
    <!-- Objectives：GameSession.cs 引用 Gameplay.Objectives 命名空间。
         缺这条 include 时症状是 CS0246 'Objectives' could not be found 出现在
         GameSession.cs 里 —— 看起来像 GameSession 的问题，实际是 csproj 漏了目录。 -->
    <Compile Include="../../unity/Assets/Scripts/Gameplay/Objectives/*.cs" />
    <!-- 三个模块的本机桩实现（零第三方依赖 → 可在本机真编译真跑；真 SDK 实现将来放同目录） -->
    <Compile Include="../../unity/Assets/Scripts/Net/*.cs" />
    <Compile Include="../../unity/Assets/Scripts/Audio/*.cs" />
    <Compile Include="../../unity/Assets/Scripts/Backend/*.cs" />
  </ItemGroup>
</Project>
