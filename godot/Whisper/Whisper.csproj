<Project Sdk="Godot.NET.Sdk/4.4.0">
  <!--
    Godot 4.4 端 · 引擎无关核心 + Godot 渲染层
    ══════════════════════════════════════════════════════════════════════════════
    为什么最终回到官方的 `Godot.NET.Sdk`
    ──────────────────────────────────────────────────────────────────────────────
    我先试了"零 nuget"的写法（`Microsoft.NET.Sdk` + `HintPath` 直接引用 `GodotSharp.dll`）：
    编译通过，但**运行时 Godot 报 `Failed to load project assembly`** ——
    因为 `Godot.NET.Sdk` 不只是"引用程序集"，它还负责**产物命名与放置**
    （`GodotSharp.dll` 随产物、`.deps.json`、以及 Godot 期望的目录形态）。
    绕开它 ⇒ 编译能过、运行起不来。**"能编过"与"能加载"是两件事。**
    ⇒ 改用官方 SDK，并用 `nuget.config` 把包源指向 **mono 版自带的 nupkgs**（离线可用）。
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Whisper</RootNamespace>
    <AssemblyName>Whisper</AssemblyName>
  </PropertyGroup>
</Project>
