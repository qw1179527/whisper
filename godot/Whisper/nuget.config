<?xml version="1.0" encoding="utf-8"?>
<!--
  离线 nuget 源：只用 Godot mono 版**自带的** nupkgs（`GodotSharp/Tools/nupkgs/`）。
  ⚠ **必须是绝对路径**（2026-10-07 实测）：
  我第一版写的是相对路径 `../../tmp/godot/mono/...`，本机 `dotnet build` 能还原
  （工作目录 = 项目目录），但 **Godot 导出时 MSBuild 报**
      `error MSB4236: The SDK 'Godot.NET.Sdk/4.4.0' specified could not be found.`
  —— 因为 Godot 调 dotnet 时的**工作目录不是项目目录**，相对路径解析失败。
  ⇒ 改成绝对路径后两边都能还原。（绝对路径绑定了本仓库位置；换机时需同步改这一行。）
-->
<configuration>
  <packageSources>
    <clear />
    <add key="godot-local" value="/data/user/0/app.dsh.mobile/files/dsh-home/whisper/tmp/godot/mono/GodotSharp/Tools/nupkgs" />
  </packageSources>
</configuration>
