<?xml version="1.0" encoding="utf-8"?>
<!--
  离线双源（2026-10-07 实测定稿）
  ══════════════════════════════════════════════════════════════════════════════
  为什么需要**两个**本地源：
  ① `godot-local` → mono 版自带的 nupkgs（Godot.NET.Sdk / GodotSharp / SourceGenerators）
  ② `flat-local` → `godot/nupkgs-flat/`（**扁平目录**：Godot 自带 nupkgs + 下载的 .NET Android 运行时包）

  ⚠ 踩过的坑：我最初写了 `<clear/>` + 只留 `godot-local`，本机 build 能过，
    但**导出时**报：
      `error NU1101: Unable to find package Microsoft.NETCore.App.Runtime.Mono.android-arm64.
        No packages exist with this id in source(s): godot-local`
    ⇒ **全局包缓存（~/.nuget/packages）不是"源"**；而且我把它当源也不行 ——
      **NuGet 的本地目录源不递归子目录**，而全局缓存是 `<pkg>/<ver>/<pkg>.<ver>.nupkg` 的嵌套结构。
      ⇒ 最终做法：**建一个扁平目录** `godot/nupkgs-flat/`，把所有需要的 `.nupkg` 平铺放进去，
        再把它列为源。（这也是唯一被实测验证能解析的方式。）

  ⚠ 路径必须是**绝对路径**：Godot 调 dotnet 时的工作目录不是项目目录，
    相对路径解析失败（会导致 `MSB4236: The SDK ... could not be found`）。
    本文件绑定本仓库位置；换机时需同步改这四处。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="godot-local" value="/data/user/0/app.dsh.mobile/files/dsh-home/whisper/tmp/godot/mono/GodotSharp/Tools/nupkgs" />
    <add key="flat-local" value="/data/user/0/app.dsh.mobile/files/dsh-home/whisper/godot/nupkgs-flat" />
  </packageSources>
</configuration>
