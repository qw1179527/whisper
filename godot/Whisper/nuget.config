<?xml version="1.0" encoding="utf-8"?>
<!--
  离线 nuget 源：只用 Godot mono 版**自带的** nupkgs（`GodotSharp/Tools/nupkgs/`）。
  ⚠ 为什么要这个文件：本机（Termux + proot）没验证过公网 nuget 可达，
  而 `Godot.NET.Sdk` 是 nuget 包 —— 用它就必须离线还原。
  mono 版把 SDK 与 GodotSharp 包都放在 `Tools/nupkgs/` 里 ⇒ 指向它即可，零联网。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="godot-local" value="../../tmp/godot/mono/GodotSharp/Tools/nupkgs" />
  </packageSources>
</configuration>
